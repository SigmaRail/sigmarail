{
  "schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SigmaRail strategy framework",
  "description": "Five fixed SigmaRail implementations. Each slot's Parameters carry its strategy configuration.",
  "version": 2,
  "slots": [
    {
      "slot": "UniverseSelection",
      "fixed": true,
      "entries": [
        {
          "Type": "SigmaRailClickHouseUniverseSelection",
          "module_hint": "SigmaRail runtime",
          "description": "ClickHouse query AST defining the selected securities.",
          "example_parameters": {}
        }
      ]
    },
    {
      "slot": "Alpha",
      "fixed": true,
      "entries": [
        {
          "Type": "SigmaRailScreenerAlphaModel",
          "module_hint": "SigmaRail runtime",
          "description": "Signals, conditions, and insight duration.",
          "example_parameters": {}
        }
      ]
    },
    {
      "slot": "PortfolioConstruction",
      "fixed": true,
      "entries": [
        {
          "Type": "SigmaRailScreenerPortfolioConstructionModel",
          "module_hint": "SigmaRail runtime",
          "description": "Allocation policy, target weights, and rebalance rules.",
          "example_parameters": {}
        }
      ]
    },
    {
      "slot": "RiskManagement",
      "fixed": true,
      "entries": [
        {
          "Type": "SigmaRailRiskManagementModel",
          "module_hint": "SigmaRail runtime",
          "description": "Declarative risk rules.",
          "example_parameters": {}
        }
      ]
    },
    {
      "slot": "Execution",
      "fixed": true,
      "entries": [
        {
          "Type": "SigmaRailScreenerExecutionModel",
          "module_hint": "SigmaRail runtime",
          "description": "Order timing and fill-session configuration.",
          "example_parameters": {}
        }
      ]
    }
  ]
}
