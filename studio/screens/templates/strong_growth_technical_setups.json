{
  "version": 2,
  "spine": "screener_price_tech_daily",
  "joins": [
    {
      "table": "screener_ratings_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    },
    {
      "table": "screener_forecast_models_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    }
  ],
  "select": [
    "ticker",
    "close",
    "growth_rate_pct",
    "setup_quality_rating",
    "rs_rating",
    "technical_rating",
    "stage_code"
  ],
  "computed": [],
  "where": {
    "type": "all",
    "items": [
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "growth_rate_pct",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 15.0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "setup_quality_rating",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 70
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "rs_rating",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 70
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 15.0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "avg_vol_50d",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 200000
        }
      }
    ]
  },
  "order_by": [
    {
      "field": "growth_rate_pct",
      "direction": "desc"
    }
  ],
  "limit_per_day": 50
}
