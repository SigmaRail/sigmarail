{
  "version": 2,
  "spine": "screener_price_tech_daily",
  "joins": [
    {
      "table": "screener_ratings_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    }
  ],
  "select": [
    "ticker",
    "close",
    "sma10d",
    "sma20d",
    "sma50d",
    "rs_rating",
    "technical_rating",
    "stage_code"
  ],
  "computed": [],
  "where": {
    "type": "all",
    "items": [
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "formula",
          "op": "*",
          "args": [
            {
              "type": "col",
              "name": "sma10d",
              "offset": 0
            },
            {
              "type": "lit",
              "value": 0.98
            }
          ]
        }
      },
      {
        "type": "lte",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "formula",
          "op": "*",
          "args": [
            {
              "type": "col",
              "name": "sma10d",
              "offset": 0
            },
            {
              "type": "lit",
              "value": 1.05
            }
          ]
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma50d",
          "offset": 0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "sma50d",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma200d",
          "offset": 0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "rs_rating",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 75
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "avg_vol_50d",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 250000
        }
      }
    ]
  },
  "order_by": [
    {
      "field": "rs_rating",
      "direction": "desc"
    }
  ],
  "limit_per_day": 50
}
