{
  "version": 2,
  "spine": "screener_price_tech_daily",
  "joins": [
    {
      "table": "screener_ratings_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    }
  ],
  "select": [
    "ticker",
    "close",
    "stage_code",
    "stage_duration",
    "rs_rating",
    "technical_rating",
    "sma50d",
    "sma200d"
  ],
  "computed": [],
  "where": {
    "type": "all",
    "items": [
      {
        "type": "any",
        "items": [
          {
            "type": "eq",
            "left": {
              "type": "col",
              "name": "stage_code",
              "offset": 0
            },
            "right": {
              "type": "lit",
              "value": "2A"
            }
          },
          {
            "type": "eq",
            "left": {
              "type": "col",
              "name": "stage_code",
              "offset": 0
            },
            "right": {
              "type": "lit",
              "value": "2B"
            }
          }
        ]
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma50d",
          "offset": 0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "sma50d",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma200d",
          "offset": 0
        }
      },
      {
        "type": "eq",
        "left": {
          "type": "col",
          "name": "sma200d_rising_30d",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 1
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "rs_rating",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 70
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "avg_vol_50d",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 200000
        }
      }
    ]
  },
  "order_by": [
    {
      "field": "rs_rating",
      "direction": "desc"
    }
  ],
  "limit_per_day": 50
}
