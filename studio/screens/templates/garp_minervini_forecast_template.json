{
  "version": 2,
  "spine": "screener_price_tech_daily",
  "joins": [
    {
      "table": "screener_fundamentals_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    },
    {
      "table": "screener_ratings_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    },
    {
      "table": "screener_stage_weekly_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    },
    {
      "table": "screener_forecast_models_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    }
  ],
  "select": [
    "ticker",
    "close",
    "rs_rating",
    "technical_rating",
    "minervini_score",
    "stage_primary",
    "mrt_epsdil",
    "growth_rate_pct",
    "target_price_normal_pe",
    "target_price_15x",
    "fwd_cagr_2y_normal_pe",
    "fwd_peg_ratio"
  ],
  "computed": [],
  "where": {
    "type": "all",
    "items": [
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma50d",
          "offset": 0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma150d",
          "offset": 0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma200d",
          "offset": 0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "sma50d",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma150d",
          "offset": 0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "sma150d",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma200d",
          "offset": 0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "price_vs_52w_low",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 1.3
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "price_vs_52w_high",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 0.8
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "rs_rating",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 70.0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "mrt_epsdil",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 0.0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "growth_rate_pct",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 12.0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "fwd_cagr_2y_normal_pe",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 15.0
        }
      },
      {
        "type": "lte",
        "left": {
          "type": "col",
          "name": "fwd_peg_ratio",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 2.5
        }
      }
    ]
  },
  "order_by": [
    {
      "field": "fwd_cagr_2y_normal_pe",
      "direction": "desc"
    }
  ],
  "limit_per_day": 50
}