{
  "version": 2,
  "spine": "screener_price_tech_daily",
  "joins": [
    {
      "table": "screener_ratings_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    },
    {
      "table": "screener_forecast_models_daily",
      "type": "left_any",
      "on": [
        "ticker",
        "date"
      ]
    }
  ],
  "select": [
    "ticker",
    "close",
    "fwd_eps_1y",
    "fwd_eps_2y",
    "growth_rate_pct",
    "fwd_cagr_2y_normal_pe",
    "rs_rating",
    "technical_rating"
  ],
  "computed": [],
  "where": {
    "type": "all",
    "items": [
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "fwd_eps_1y",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 0.0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "fwd_eps_2y",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "fwd_eps_1y",
          "offset": 0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "growth_rate_pct",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 8.0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "fwd_cagr_2y_normal_pe",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 10.0
        }
      },
      {
        "type": "gt",
        "left": {
          "type": "col",
          "name": "close",
          "offset": 0
        },
        "right": {
          "type": "col",
          "name": "sma200d",
          "offset": 0
        }
      },
      {
        "type": "gte",
        "left": {
          "type": "col",
          "name": "avg_vol_50d",
          "offset": 0
        },
        "right": {
          "type": "lit",
          "value": 300000
        }
      }
    ]
  },
  "order_by": [
    {
      "field": "fwd_cagr_2y_normal_pe",
      "direction": "desc"
    }
  ],
  "limit_per_day": 50
}