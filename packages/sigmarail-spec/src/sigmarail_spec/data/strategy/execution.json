{
  "executable_strategy_schema": {
    "$defs": {
      "DataSourceJoin": {
        "additionalProperties": false,
        "description": "Join specification matching screener join syntax.",
        "properties": {
          "on": {
            "items": {
              "type": "string"
            },
            "title": "On",
            "type": "array"
          },
          "select": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Select"
          },
          "table": {
            "title": "Table",
            "type": "string"
          },
          "type": {
            "default": "left_any",
            "enum": [
              "left_any",
              "inner",
              "left",
              "right",
              "full"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "table",
          "on"
        ],
        "title": "DataSourceJoin",
        "type": "object"
      },
      "DataSourceSpec": {
        "additionalProperties": false,
        "description": "Specification for a data source — graph policy and store-backed SigmaRailStrategyV1.\n\nStore-backed specs set ``Type`` (loader class), ``grain`` (session | ticker_date |\ndaily), optional ``uses`` / ``score`` for regime policy (C-REGIME-POLICY-V1).",
        "properties": {
          "Type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Type"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of"
          },
          "cache_per_date": {
            "default": true,
            "title": "Cache Per Date",
            "type": "boolean"
          },
          "date_column": {
            "default": "date",
            "title": "Date Column",
            "type": "string"
          },
          "grain": {
            "default": "daily",
            "title": "Grain",
            "type": "string"
          },
          "joins": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/DataSourceJoin"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Joins"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          },
          "select": {
            "items": {
              "type": "string"
            },
            "title": "Select",
            "type": "array"
          },
          "table": {
            "default": "",
            "title": "Table",
            "type": "string"
          },
          "uses": {
            "items": {
              "type": "string"
            },
            "title": "Uses",
            "type": "array"
          },
          "where": {
            "anyOf": [
              {
                "$ref": "#/$defs/DataSourceWhere"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "name"
        ],
        "title": "DataSourceSpec",
        "type": "object"
      },
      "DataSourceWhere": {
        "additionalProperties": false,
        "description": "Where clause - simplified for runtime evaluation (not full AST).",
        "properties": {
          "filters": {
            "additionalProperties": true,
            "title": "Filters",
            "type": "object"
          }
        },
        "title": "DataSourceWhere",
        "type": "object"
      },
      "EvaluationSettings": {
        "description": "Backtest / paper window and account identity. Live uses cash + benchmark; dates are research.",
        "properties": {
          "benchmark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Benchmark"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Date"
          },
          "initial_cash": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Initial Cash"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Date"
          }
        },
        "title": "EvaluationSettings",
        "type": "object"
      },
      "FixedClickHouseUniverseSelectionV1": {
        "additionalProperties": false,
        "description": "Fixed ClickHouse query universe; the AST is this slot's configuration.",
        "properties": {
          "Parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "Type": {
            "const": "SigmaRailClickHouseUniverseSelection",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "Type"
        ],
        "title": "FixedClickHouseUniverseSelectionV1",
        "type": "object"
      },
      "FixedSigmaRailAlphaV1": {
        "additionalProperties": false,
        "properties": {
          "Parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "Type": {
            "const": "SigmaRailScreenerAlphaModel",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "Type"
        ],
        "title": "FixedSigmaRailAlphaV1",
        "type": "object"
      },
      "FixedSigmaRailExecutionV1": {
        "additionalProperties": false,
        "properties": {
          "Parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "Type": {
            "const": "SigmaRailScreenerExecutionModel",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "Type"
        ],
        "title": "FixedSigmaRailExecutionV1",
        "type": "object"
      },
      "FixedSigmaRailPortfolioConstructionV1": {
        "additionalProperties": false,
        "properties": {
          "Parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "Type": {
            "const": "SigmaRailScreenerPortfolioConstructionModel",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "Type"
        ],
        "title": "FixedSigmaRailPortfolioConstructionV1",
        "type": "object"
      },
      "FixedSigmaRailRiskManagementV1": {
        "additionalProperties": false,
        "properties": {
          "Parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "Type": {
            "const": "SigmaRailRiskManagementModel",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "Type"
        ],
        "title": "FixedSigmaRailRiskManagementV1",
        "type": "object"
      },
      "SigmaRailFacet": {
        "additionalProperties": false,
        "description": "Data-plane settings; universe configuration lives in Framework.UniverseSelection.",
        "properties": {
          "DataSources": {
            "items": {
              "$ref": "#/$defs/DataSourceSpec"
            },
            "title": "Datasources",
            "type": "array"
          },
          "Evaluation": {
            "anyOf": [
              {
                "$ref": "#/$defs/EvaluationSettings"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "Pipeline": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pipeline"
          },
          "PolicyGraph": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Policygraph"
          },
          "Regime": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Regime"
          }
        },
        "title": "SigmaRailFacet",
        "type": "object"
      },
      "SigmaRailStrategyFrameworkV1": {
        "additionalProperties": false,
        "description": "Five fixed SigmaRail implementations; Parameters hold all slot configuration.",
        "properties": {
          "Alpha": {
            "$ref": "#/$defs/FixedSigmaRailAlphaV1"
          },
          "Execution": {
            "$ref": "#/$defs/FixedSigmaRailExecutionV1"
          },
          "PortfolioConstruction": {
            "$ref": "#/$defs/FixedSigmaRailPortfolioConstructionV1"
          },
          "RiskManagement": {
            "$ref": "#/$defs/FixedSigmaRailRiskManagementV1"
          },
          "UniverseSelection": {
            "$ref": "#/$defs/FixedClickHouseUniverseSelectionV1"
          }
        },
        "required": [
          "UniverseSelection",
          "Alpha",
          "PortfolioConstruction",
          "Execution",
          "RiskManagement"
        ],
        "title": "SigmaRailStrategyFrameworkV1",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Current strategy document with five fixed SigmaRail framework slots.",
    "properties": {
      "AlgorithmParameters": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "Keys passed via SetParameter (regime-source, exit-mode, …) when composed with CH alpha",
        "title": "Algorithmparameters",
        "type": "object"
      },
      "Framework": {
        "$ref": "#/$defs/SigmaRailStrategyFrameworkV1"
      },
      "Kind": {
        "const": "SigmaRailStrategyV1",
        "title": "Kind",
        "type": "string"
      },
      "SchemaVersion": {
        "const": 3,
        "title": "Schemaversion",
        "type": "integer"
      },
      "SigmaRail": {
        "$ref": "#/$defs/SigmaRailFacet"
      },
      "title": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Human strategy name (compile/decompile round-trip; optional at runtime)",
        "title": "Title"
      }
    },
    "required": [
      "SchemaVersion",
      "Kind",
      "Framework",
      "SigmaRail"
    ],
    "title": "SigmaRailStrategyV1Document",
    "type": "object"
  },
  "lean_framework_schema": {
    "$defs": {
      "FrameworkBundleV1": {
        "additionalProperties": false,
        "description": "Four LEAN model slots for a standalone LeanFrameworkV1 document.",
        "properties": {
          "Alpha": {
            "$ref": "#/$defs/FrameworkSlotSpec"
          },
          "Execution": {
            "$ref": "#/$defs/FrameworkSlotSpec"
          },
          "PortfolioConstruction": {
            "$ref": "#/$defs/FrameworkSlotSpec"
          },
          "RiskManagement": {
            "$ref": "#/$defs/FrameworkSlotSpec"
          }
        },
        "required": [
          "Alpha",
          "PortfolioConstruction",
          "Execution",
          "RiskManagement"
        ],
        "title": "FrameworkBundleV1",
        "type": "object"
      },
      "FrameworkSlotSpec": {
        "additionalProperties": false,
        "description": "One framework slot: QC class name + constructor kwargs.",
        "properties": {
          "Parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "Type": {
            "description": "Allowlisted Lean / QC Python class name",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "Type"
        ],
        "title": "FrameworkSlotSpec",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Phase-1 document: wire standard QC framework models only (no SigmaRail / ClickHouse).\n\nJSON uses SchemaVersion + Kind; distinct from legacy pipeline JSON (schema_version: 1).\nSupply **Framework** inline or **FrameworkPreset** (named bundle), not both.",
    "properties": {
      "Algorithm": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional hints (e.g. StartCash); dates/cash v1 from config.json / parameters",
        "title": "Algorithm"
      },
      "Framework": {
        "$ref": "#/$defs/FrameworkBundleV1"
      },
      "FrameworkPreset": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Named allowlisted bundle; alternative to inline Framework.",
        "title": "Frameworkpreset"
      },
      "Kind": {
        "const": "LeanFrameworkV1",
        "title": "Kind",
        "type": "string"
      },
      "SchemaVersion": {
        "const": 2,
        "title": "Schemaversion",
        "type": "integer"
      }
    },
    "required": [
      "SchemaVersion",
      "Kind",
      "Framework"
    ],
    "title": "LeanFrameworkV1Document",
    "type": "object"
  },
