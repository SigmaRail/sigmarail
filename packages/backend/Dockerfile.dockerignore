# The AppTension image build intentionally reads only this worktree's Django
# package/domain modules and the two shared contract packages from the
# FinanceProjects workspace. Everything else (especially local credentials,
# databases, caches, and frontend dependencies) stays outside the build context.
**
!.worktrees
!.worktrees/sigmarail-studio-apptension
!.worktrees/sigmarail-studio-apptension/packages
!.worktrees/sigmarail-studio-apptension/packages/backend
!.worktrees/sigmarail-studio-apptension/packages/backend/**
!.worktrees/sigmarail-studio-apptension/api
!.worktrees/sigmarail-studio-apptension/api/**
!.worktrees/sigmarail-studio-apptension/screens
!.worktrees/sigmarail-studio-apptension/screens/**
!.worktrees/sigmarail-studio-apptension/sigmarail_studio_mcp
!.worktrees/sigmarail-studio-apptension/sigmarail_studio_mcp/**
!VeraBase
!VeraBase/src
!VeraBase/src/vera_query_core
!VeraBase/src/vera_query_core/**
!VeraBase/src/vera
!VeraBase/src/vera/config.py
!VeraBase/src/vera/__init__.py
!VeraBase/sql
!VeraBase/sql/schema
!VeraBase/sql/schema/**
!VeraSpec
!VeraSpec/src
!VeraSpec/src/vera_spec
!VeraSpec/src/vera_spec/**
**/.env
**/.env.*
**/.venv
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/db.sqlite3
