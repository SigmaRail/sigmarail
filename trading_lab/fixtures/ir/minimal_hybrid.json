{
  "SchemaVersion": 3,
  "Kind": "SigmaRailStrategyV1",
  "title": "Minimal SigmaRail strategy",
  "Framework": {
    "UniverseSelection": {
      "Type": "SigmaRailClickHouseUniverseSelection",
      "Parameters": {
        "query": {
          "version": 1,
          "select": [
            "ticker",
            "close",
            "overall_score",
            "minervini_tt_all_conditions_full"
          ],
          "where": {
            "type": "eq",
            "left": {
              "type": "col",
              "name": "minervini_tt_all_conditions_full"
            },
            "right": {
              "type": "lit",
              "value": 1
            }
          },
          "order_by": [
            {
              "field": "overall_score",
              "direction": "desc"
            }
          ],
          "limit_per_day": 101
        }
      }
    },
    "Alpha": {
      "Type": "SigmaRailScreenerAlphaModel",
      "Parameters": {
        "signal_mode": "screen",
        "max_positions": 10
      }
    },
    "PortfolioConstruction": {
      "Type": "SigmaRailScreenerPortfolioConstructionModel",
      "Parameters": {
        "allocation_policy": "equal_weight",
        "max_positions": 10
      }
    },
    "Execution": {
      "Type": "SigmaRailScreenerExecutionModel",
      "Parameters": {
        "fill_session": "moo"
      }
    },
    "RiskManagement": {
      "Type": "SigmaRailRiskManagementModel",
      "Parameters": {
        "rules": [
          {
            "kind": "max_drawdown_per_security",
            "parameters": {
              "maximum_drawdown_percent": 0.1
            }
          }
        ]
      }
    }
  },
  "AlgorithmParameters": {},
  "SigmaRail": {}
}
